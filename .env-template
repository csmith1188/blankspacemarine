# Schoology OAuth 1.0a API credentials
SCHOOLOGY_KEY=your_schoology_consumer_key
SCHOOLOGY_SECRET=your_schoology_consumer_secret
# District or default Schoology web domain for 3-legged OAuth authorize redirect
SCHOOLOGY_DOMAIN=app.schoology.com
