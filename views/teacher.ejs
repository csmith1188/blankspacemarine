<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teacher Panel — Blank Space Marine</title>
  <link rel="stylesheet" href="/styles/theme.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('partials/nav') %>

    <main class="page-container">
      <section class="panel page-hero">
        <div>
          <span class="panel-tag">TEACHER COMMAND DECK</span>
          <h1 class="page-heading">Your Formbar Classes</h1>
          <p class="page-lead">
            Select a class to view student Blank Space Marine scores, manage Schoology IDs, and upload assignment grades or send Schoology progress reports.
          </p>
        </div>
        <div class="action-row">
          <a href="/teacher" class="btn btn-secondary">Refresh Classes from Formbar</a>
        </div>
      </section>

      <% if (classes.length === 0) { %>
        <section class="panel section-card">
          <p class="term-muted">
            No Formbar classes found for your teacher account yet. Make sure <code>AUTH_URL</code> and <code>API_KEY</code> are configured and you own or teach a class in Formbar.
          </p>
        </section>
      <% } else { %>
        <section class="class-grid">
          <% classes.forEach(function(cls) { %>
            <a href="/teacher/classes/<%= cls.id %>" class="panel class-card">
              <div class="scope-card-top">
                <span class="panel-tag">FORMBAR CLASS #<%= cls.formbar_class_id %></span>
                <span class="status-badge status-ready"><%= cls.student_count %> student<%= cls.student_count === 1 ? '' : 's' %></span>
              </div>
              <h2 class="class-card-title"><%= cls.name %></h2>
              <p class="scope-subtitle mono">
                <% if (cls.schoology_section_id) { %>
                  Schoology Course: <%= cls.schoology_section_id %>
                  <% if (cls.schoology_assignment_id) { %>
                    &middot; Assignment: <%= cls.schoology_assignment_id %>
                  <% } else { %>
                    &middot; Mode: Message Report
                  <% } %>
                <% } else { %>
                  Schoology not configured yet
                <% } %>
              </p>
              <span class="btn btn-primary btn-sm">Open Class Scores &amp; Schoology</span>
            </a>
          <% }) %>
        </section>
      <% } %>
    </main>
  </div>
</body>
</html>
